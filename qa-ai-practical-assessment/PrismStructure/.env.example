# Application URLs
BASE_URL=https://practicesoftwaretesting.com
API_BASE_URL=https://api.practicesoftwaretesting.com

# Seeded test accounts — set in .env locally; never commit .env
# Public SUT reference: https://github.com/testsmith-io/practice-software-testing
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
CUSTOMER2_EMAIL=
CUSTOMER2_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Password for newly registered users (must meet SUT rules: 8+ chars, upper, lower, number, symbol)
REGISTRATION_PASSWORD=

# Optional: prefix for generated emails (default: qa.auto)
# TEST_EMAIL_PREFIX=qa.auto
